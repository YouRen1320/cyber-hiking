<view class="container">
  <!-- 背景图片 -->
  <image class="bg-image" src="{{bgImage}}" mode="aspectFill"></image>
  
  <!-- 渐变遮罩 -->
  <view class="overlay"></view>
  <view class="vignette"></view>
  
  <!-- 头部 -->
  <view class="header">
    <text class="title">身份抉择</text>
    <text class="subtitle">Who are you?</text>
  </view>
  
  <!-- 角色轮播 -->
  <swiper 
    class="role-swiper" 
    current="{{currentIndex}}" 
    bindchange="onSwiperChange"
    previous-margin="0" 
    next-margin="0">
    <swiper-item wx:for="{{roleList}}" wx:key="id" class="swiper-item">
      <view class="role-card {{index === currentIndex ? 'active' : ''}}">
        <!-- 角色头部 -->
        <view class="role-header">
          <view class="avatar-box">
            <text class="avatar">{{item.avatar}}</text>
          </view>
          <view class="role-info">
            <text class="role-name">{{item.name}}</text>
            <text class="role-title">{{item.title}}</text>
          </view>
        </view>
        
        <view class="divider-line"></view>
        
        <!-- 角色描述 -->
        <scroll-view scroll-y class="desc-box">
          <text class="role-desc">{{item.description}}</text>
        </scroll-view>
        
        <!-- 属性面板 -->
        <view class="stats-panel">
          <view class="stat-row">
            <text class="label">体能</text>
            <view class="progress-bg">
              <view class="progress-fill hp" style="width: {{item.stats.maxHp / 150 * 100}}%"></view>
            </view>
            <text class="value">{{item.stats.maxHp}}</text>
          </view>
          <view class="stat-row">
            <text class="label">意志</text>
            <view class="progress-bg">
              <view class="progress-fill sanity" style="width: {{item.stats.maxSanity / 150 * 100}}%"></view>
            </view>
            <text class="value">{{item.stats.maxSanity}}</text>
          </view>
        </view>
        
        <!-- 初始装备 -->
        <view class="equipment-box">
          <text class="section-title">初始装备</text>
          <view class="items-grid">
            <view wx:for="{{item.itemNames}}" wx:for-item="itemName" wx:key="*this" class="item-chip">
              <text class="chip-text">{{itemName}}</text>
            </view>
          </view>
        </view>
        
        <!-- 锁定遮罩 -->
        <view wx:if="{{item.isLocked}}" class="locked-overlay">
          <text class="lock-icon">🔒</text>
          <text class="lock-text">未解锁</text>
          <text class="lock-condition">{{item.unlockCondition}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>
  
  <!-- 底部按钮 -->
  <view class="footer">
    <button class="btn-start" bindtap="onShowGuide" disabled="{{isCurrentLocked}}">
      <text wx:if="{{!isCurrentLocked}}" class="btn-text">踏入荒野</text>
      <text wx:else class="btn-text">无法选择</text>
    </button>
  </view>

  <!-- 玩法说明弹窗 -->
  <view wx:if="{{showGuide}}" class="guide-modal">
    <view class="guide-card">
      <text class="guide-title">生存指南</text>
      
      <view class="guide-section">
        <text class="section-label">生命体征</text>
        <view class="status-row">
          <text class="icon">❤️</text>
          <view class="status-desc">
            <text class="status-name">体能 (HP)</text>
            <text class="status-detail">归零即死亡。恶劣天气、受伤会扣除。</text>
          </view>
        </view>
        <view class="status-row">
          <text class="icon">🍞</text>
          <view class="status-desc">
            <text class="status-name">饱食度</text>
            <text class="status-detail">行动会消耗。耗尽后每回合扣除体能。</text>
          </view>
        </view>
        <view class="status-row">
          <text class="icon">🧠</text>
          <view class="status-desc">
            <text class="status-name">理智 (SAN)</text>
            <text class="status-detail">通过恐怖地带扣除。过低会产生幻觉。</text>
          </view>
        </view>
      </view>

      <view class="guide-section">
        <text class="section-label">玩法说明</text>
        <text class="guide-text">这是一次文字冒险。你的选择决定生死。</text>
        <text class="guide-text">合理分配物资，注意天气变化，活下去。</text>
      </view>

      <button class="btn-confirm" bindtap="onStartGame">出发</button>
    </view>
  </view>
  
  <!-- 过渡动画 -->
  <view wx:if="{{isTransitioning}}" class="transition-overlay">
    <text class="transition-text">{{loadingText}}</text>
    <view class="loading-bar-container">
      <view class="loading-bar-fill" style="width: {{loadingProgress}}%"></view>
    </view>
    <text class="loading-percent">{{loadingProgress}}%</text>
  </view>
</view>
