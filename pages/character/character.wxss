/* pages/character/character.wxss */

.container {
  width: 100%;
  height: 100vh;
  background: #1a1a1a;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  font-family: sans-serif;
  box-sizing: border-box;
}

.bg-image {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0.4;
  filter: grayscale(100%);
}

.overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0), #000);
  pointer-events: none;
}

.vignette {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1;
}

.header {
  position: relative;
  z-index: 10;
  padding-top: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  color: #fff;
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.5);
}

.subtitle {
  font-size: 24rpx;
  color: #aaa;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.role-swiper {
  position: relative;
  z-index: 10;
  flex: 1;
  width: 100%;
  padding-top: 20rpx;
  min-height: 0;
}

.swiper-item {
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  padding-bottom: 20rpx;
}

.role-card {
  width: 90%;
  height: 100%;
  max-height: 96%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  box-sizing: border-box;
  transition: all 0.4s ease;
  transform: scale(0.92);
  opacity: 0.7;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
  color: #333;
}

.role-card.active {
  transform: scale(1);
  opacity: 1;
  background: #fff;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.6);
}

.role-header {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
  align-items: center;
  flex-shrink: 0;
}

.avatar-box {
  width: 100rpx;
  height: 100rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 10rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  font-size: 50rpx;
}

.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.role-name {
  font-size: 36rpx;
  color: #000;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.role-title {
  font-size: 22rpx;
  color: #666;
  font-style: italic;
}

.divider-line {
  width: 100%;
  height: 2rpx;
  background: #e0e0e0;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.desc-box {
  flex: 1;
  height: 0;
  margin-bottom: 20rpx;
  background: #fdfdfd;
  padding: 16rpx;
  border-radius: 8rpx;
  border: 1px dashed #ddd;
  box-sizing: border-box;
}

.role-desc {
  font-size: 26rpx;
  color: #444;
  line-height: 1.5;
  font-family: serif;
}

.stats-panel {
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.stat-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 100rpx;
  font-size: 24rpx;
  color: #666;
  font-weight: 600;
}

.progress-bg {
  flex: 1;
  height: 12rpx;
  background: #eee;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
}

.progress-fill.hp {
  background: #ff6b6b;
}

.progress-fill.sanity {
  background: #4dabf7;
}

.value {
  width: 50rpx;
  font-size: 24rpx;
  color: #333;
  text-align: right;
  font-weight: 700;
}

.section-title {
  font-size: 20rpx;
  color: #888;
  margin-bottom: 12rpx;
  display: block;
  text-transform: uppercase;
  font-weight: 700;
}

.items-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.item-chip {
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  border: 1px solid #e0e0e0;
}

.chip-text {
  font-size: 22rpx;
  color: #555;
  font-weight: 500;
}

.footer {
  padding: 30rpx 0 60rpx;
  display: flex;
  justify-content: center;
  z-index: 10;
  flex-shrink: 0;
}

.btn-start {
  width: 70%;
  height: 100rpx;
  background: linear-gradient(135deg, #3498db, #2980b9);
  color: #fff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 40rpx rgba(52, 152, 219, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.2);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 4rpx;
}

.btn-start:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(52, 152, 219, 0.3);
  filter: brightness(0.9);
}

.btn-start[disabled] {
  background: #333;
  color: #666;
  box-shadow: none;
  border-color: rgba(255, 255, 255, 0.05);
  opacity: 1;
}

.btn-text {
  color: inherit;
}

.locked-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20;
  color: #fff;
}

.lock-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.lock-text {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.lock-condition {
  font-size: 24rpx;
  color: #ccc;
  background: rgba(255, 255, 255, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.transition-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #000;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  animation: fadeIn 0.5s ease-out;
}

.transition-text {
  color: #fff;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  opacity: 0.8;
}

.loading-bar-container {
  width: 60%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
}

.loading-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #3498db, #2ecc71);
  border-radius: 4rpx;
  transition: width 0.1s ease-out;
}

.loading-percent {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.equipment-box {
  flex-shrink: 0;
}
/* 玩法说明弹窗 */
.guide-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(5px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease-out;
}

.guide-card {
  width: 85%;
  background: #1a1a1a;
  border: 1px solid #333;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.8);
  display: flex;
  flex-direction: column;
}

.guide-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 2rpx;
}

.guide-section {
  margin-bottom: 30rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.status-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 50rpx;
  text-align: center;
}

.status-desc {
  flex: 1;
}

.status-name {
  display: block;
  font-size: 28rpx;
  color: #e0e0e0;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.status-detail {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.guide-text {
  display: block;
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.btn-confirm {
  margin-top: 20rpx;
  width: 100%;
  height: 90rpx;
  background: #fff;
  color: #000;
  font-weight: 700;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
