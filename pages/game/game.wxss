/* === 基础容器 === */
.game-container {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
  background: #0a0a0a;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica,
    Segoe UI, Arial, Roboto, "PingFang SC", "miui", "Hiragino Sans GB",
    "Microsoft Yahei", sans-serif;
}

/* 背景层 (全屏绝对定位) */
.visual-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-image {
  width: 100%;
  height: 100%;
  opacity: 0.5;
  /* 降低背景亮度，突出文字 */
  filter: saturate(0.8) contrast(1.1);
}

.night-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 20, 0.8), rgba(0, 0, 20, 0.9));
  pointer-events: none;
}

/* === HUD 头部信息 === */
.top-hud {
  position: relative;
  z-index: 10;
  padding: 84rpx 180rpx 24rpx 32rpx;
  background: linear-gradient(180deg,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0) 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 左侧面板 */
.hud-left-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.day-weather-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  align-self: flex-start;
}

.day-text {
  font-size: 32rpx;
  font-weight: 800;
  margin-right: 16rpx;
  letter-spacing: 2rpx;
  color: #fff;
}

.weather-icon {
  font-size: 36rpx;
}

/* 进度徽章 (替代原有进度条) */
.progress-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 8rpx;
}

.progress-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.progress-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #3498db;
  font-family: monospace;
}

/* 右侧属性条 */
.stat-bars {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 260rpx;
  /* 限制宽度 */
}

.stat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-emoji {
  font-size: 22rpx;
  width: 30rpx;
  text-align: center;
}

.stat-track {
  flex: 1;
  height: 8rpx;
  /* 变细 */
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease-out;
}

.stat-fill.hp {
  background: #ff4d4d;
}

.stat-fill.hunger {
  background: #f1c40f;
}

.stat-fill.sanity {
  background: #5dade2;
}

.stat-value {
  width: 40rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  font-family: monospace;
}

/* === 悬浮按钮 === */
.bag-fab {
  margin-top: auto;
  margin-right: 40rpx;
  margin-left: auto;
  z-index: 50;
}

.bag-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: rgba(30, 30, 30, 0.85);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.5);
  transition: transform 0.1s, background 0.2s;
}

.bag-icon-wrapper:active {
  transform: scale(0.92);
  background: rgba(50, 50, 50, 0.95);
}

.bag-emoji {
  font-size: 48rpx;
  /* 稍微放大图标 */
}

.bag-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #1a1a1a;
  font-weight: bold;
}

/* === 故事主区域 === */
.story-scroll {
  flex: 1;
  position: relative;
  z-index: 10;
}

.story-card {
  margin: 0 40rpx;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.story-text {
  font-size: 34rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.95);
  text-align: justify;
  letter-spacing: 1rpx;
}

.cursor {
  display: inline-block;
  color: #3498db;
  animation: blink 1s infinite;
  font-weight: bold;
  margin-left: 4rpx;
}

@keyframes blink {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0;
  }
}

/* === 选项区域 === */
.action-bar {
  position: relative;
  z-index: 20;
  padding: 20rpx 40rpx 60rpx;
  /* 底部留白 */
  background: linear-gradient(0deg,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0) 100%);
}

.action-bar.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.night-warning-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  padding: 12rpx;
  background: rgba(231, 76, 60, 0.2);
  border-radius: 12rpx;
  border: 1px solid rgba(231, 76, 60, 0.3);
}

.night-warning-bar text {
  font-size: 24rpx;
  color: #ff8a80;
}

.warning-icon {
  margin-right: 12rpx;
}

.choices-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.choice-card {
  background: rgba(40, 40, 40, 0.7);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s ease;
}

.choice-card:active {
  transform: scale(0.98);
  background: rgba(60, 60, 60, 0.8);
}

.choice-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-right: 20rpx;
}

.choice-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.cost-preview {
  display: flex;
  gap: 12rpx;
}

.cost-tag {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.cost-tag.hunger {
  background: rgba(241, 196, 15, 0.2);
  color: #f1c40f;
}

.cost-tag.sanity {
  background: rgba(52, 152, 219, 0.2);
  color: #3498db;
}

.choice-arrow {
  color: rgba(255, 255, 255, 0.3);
  font-size: 32rpx;
  font-family: monospace;
}

/* === 模态框通用层级 === */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  animation: fadeIn 0.4s forwards;
}

/* 游戏结束卡片 */
.gameover-card {
  width: 80%;
  max-width: 600rpx;
  background: rgba(30, 30, 30, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 40rpx 100rpx rgba(0, 0, 0, 0.8);
  transform: scale(0.9);
  animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

.gameover-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.gameover-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.gameover-message {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.stats-summary {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 50rpx;
  width: 100%;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-box .val {
  font-size: 36rpx;
  font-weight: 700;
  color: #3498db;
  font-family: monospace;
}

.stat-box .label {
  font-size: 22rpx;
  color: #888;
}

.action-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.primary-btn {
  width: 100%;
  background: #3498db;
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 0;
  border-radius: 50rpx;
  border: none;
  font-weight: 600;
}

.secondary-btn {
  width: 100%;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 0;
  border-radius: 50rpx;
  border: none;
}

@keyframes popIn {
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.inventory-modal {
  width: 85%;
  height: 70%;
  background: #1c1c1e;
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.5);
  transform: translateY(20px);
  animation: slideUp 0.3s forwards;
}

.modal-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  background: #252528;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.weight-indicator {
  background: #333;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.weight-val {
  font-size: 24rpx;
  color: #aaa;
  font-family: monospace;
}

.weight-val.overweight {
  color: #e74c3c;
}

/* 装备栅格 */
.equipment-grid {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 20rpx;
  background: #202022;
}

.equip-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.slot-bg {
  width: 90rpx;
  height: 90rpx;
  background: #2c2c2e;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(255, 255, 255, 0.1);
}

.slot-bg.equipped {
  background: #3a3a3c;
  border: 2rpx solid #3498db;
}

.slot-icon {
  font-size: 40rpx;
}

.slot-label {
  font-size: 22rpx;
  color: #666;
}

.divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.05);
  margin: 0 30rpx;
}

/* 物品列表 */
.items-scroll {
  flex: 1;
  background: #151517;
  padding: 20rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  color: #444;
  font-size: 26rpx;
}

.inventory-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #252528;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.item-visual {
  width: 80rpx;
  height: 80rpx;
  background: #333;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.item-emoji {
  font-size: 40rpx;
}

.item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-name {
  font-size: 28rpx;
  color: #eee;
  font-weight: 500;
}

.item-weight {
  font-size: 20rpx;
  color: #666;
}

.item-desc {
  font-size: 22rpx;
  color: #888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 300rpx;
}

.use-btn {
  padding: 10rpx 24rpx;
  background: #3498db;
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
  margin-left: 20rpx;
}

.modal-footer {
  padding: 30rpx;
  background: #252528;
  display: flex;
  justify-content: center;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.modal-footer text {
  color: #888;
  font-size: 28rpx;
}

/* === 动画 === */
@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(40px);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* === 视觉效果层 === */
.damage-flash {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(231, 76, 60, 0.4);
  pointer-events: none;
  opacity: 0;
  z-index: 50;
  transition: opacity 0.15s;
}

.damage-flash.active {
  opacity: 1;
}

.notification-toast {
  position: fixed;
  top: 180rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  background: rgba(0, 0, 0, 0.8);
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  animation: toastPop 0.3s ease-out;
}

.notification-toast text {
  color: #fff;
  font-size: 26rpx;
}

.notification-toast.success {
  border: 1px solid #2ecc71;
  color: #2ecc71;
}

.notification-toast.warning {
  border: 1px solid #f1c40f;
  color: #f1c40f;
}

@keyframes toastPop {
  0% {
    transform: translateX(-50%) scale(0.9);
    opacity: 0;
  }

  100% {
    transform: translateX(-50%) scale(1);
    opacity: 1;
  }
}