/* pages/index/index.wxss */

/* 音乐按钮 */
.music-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 70rpx;
  height: 70rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  backdrop-filter: blur(4px);
  transition: all 0.2s ease;
}

.music-btn .icon {
  font-size: 28rpx;
  opacity: 0.9;
}

.music-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.25);
}

/* 容器 */
.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #0a0a0a;
}

/* 背景图片 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.7;
  animation: bgBreathing 24s ease-in-out infinite;
  transform-origin: center center;
}

@keyframes bgBreathing {
  0% {
    transform: scale(1.15);
  }
  50% {
    transform: scale(1);
  }
  100% {
    transform: scale(1.15);
  }
}

/* 雪花容器 */
.snow-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 6;
  pointer-events: none;
}

.snowflake {
  position: absolute;
  top: -20rpx;
  background: #fff;
  border-radius: 50%;
  filter: blur(2rpx);
  animation: snowfall linear infinite;
}

@keyframes snowfall {
  0% {
    transform: translateY(0) translateX(0);
  }
  25% {
    transform: translateY(25vh) translateX(15rpx);
  }
  50% {
    transform: translateY(50vh) translateX(-15rpx);
  }
  75% {
    transform: translateY(75vh) translateX(15rpx);
  }
  100% {
    transform: translateY(105vh) translateX(0);
  }
}

/* 渐变遮罩 */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(15, 23, 33, 0.2),
    rgba(10, 18, 28, 0.5) 40%,
    rgba(5, 10, 18, 0.85)
  );
  z-index: 5;
}

/* 内容区域 */
.content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 50rpx;
}

/* 标题区域 */
.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.main-title {
  font-size: 84rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 12rpx;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3), 0 10rpx 40rpx rgba(0, 0, 0, 0.5),
    0 0 80rpx rgba(100, 200, 255, 0.3);
  margin-bottom: 30rpx;
  white-space: nowrap;
}

.subtitle-wrap {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
  opacity: 0.9;
}

.divider-line {
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.8),
    transparent
  );
}

.subtitle {
  font-size: 26rpx;
  color: rgba(220, 230, 240, 0.9);
  letter-spacing: 12rpx;
  font-weight: 300;
  text-transform: uppercase;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.quote-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.quote {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  font-style: italic;
  letter-spacing: 3rpx;
  line-height: 1.5;
}

/* 按钮组 */
.btn-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  max-width: 520rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 100rpx;
  transition: all 0.2s ease;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  padding: 0 60rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3),
    inset 0 0 30rpx rgba(255, 255, 255, 0.05);
}

.btn-primary:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.btn-icon {
  font-size: 32rpx;
  color: #fff;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.5);
}

.btn-text-primary {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.btn-secondary {
  padding: 0 60rpx;
  background: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50rpx;
}

.btn-secondary:active {
  background: rgba(0, 0, 0, 0.4);
  border-color: rgba(255, 255, 255, 0.2);
}

.btn-icon-secondary {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
}

.btn-text-secondary {
  font-size: 32rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 6rpx;
}

.btn-text-link {
  padding: 20rpx 40rpx;
  background: transparent;
  margin-top: 0;
  transition: all 0.3s ease;
}

.btn-text-link:active {
  opacity: 0.6;
}

.btn-icon-link {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.btn-text-link-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 4rpx;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* 底部警告 */
.footer-warning {
  position: absolute;
  bottom: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}

.warning-text {
  font-size: 20rpx;
  color: rgba(255, 180, 180, 0.6);
  letter-spacing: 2rpx;
}

/* 模态框 */
.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.modal-content {
  width: 560rpx;
  padding: 48rpx;
  background: rgba(30, 40, 50, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: scaleUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.modal-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.modal-btn.cancel {
  background: rgba(255, 255, 255, 0.1);
}

.modal-btn.cancel:active {
  background: rgba(255, 255, 255, 0.15);
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #4a90e2, #0056b3);
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

.modal-btn.confirm:active {
  transform: scale(0.96);
}

.modal-btn-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

.modal-btn-text.highlight {
  color: #fff;
  font-weight: 600;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes scaleUp {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
