/* pages/index/index.wxss */

/* 容器 */
.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #0a0a0a;
  box-sizing: border-box;
}

/* 背景图片 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.7;
  animation: bgBreathing 24s ease-in-out infinite;
  transform-origin: center center;
}

@keyframes bgBreathing {
  0% {
    transform: scale(1.15);
  }
  50% {
    transform: scale(1);
  }
  100% {
    transform: scale(1.15);
  }
}

/* 雪花容器 */
.snow-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 6;
  pointer-events: none;
}

.snowflake {
  position: absolute;
  top: -20rpx;
  background: #fff;
  border-radius: 50%;
  filter: blur(2rpx);
  animation: snowfall linear infinite;
}

@keyframes snowfall {
  0% {
    transform: translateY(0) translateX(0);
  }
  25% {
    transform: translateY(25vh) translateX(15rpx);
  }
  50% {
    transform: translateY(50vh) translateX(-15rpx);
  }
  75% {
    transform: translateY(75vh) translateX(15rpx);
  }
  100% {
    transform: translateY(105vh) translateX(0);
  }
}

/* 渐变遮罩 */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(15, 23, 33, 0.2),
    rgba(10, 18, 28, 0.5) 40%,
    rgba(5, 10, 18, 0.85)
  );
  z-index: 5;
}

/* 内容区域 */
.content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 50rpx;
  box-sizing: border-box;
}

/* === 音乐开关 === */
.music-toggle {
  position: absolute;
  z-index: 50;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s;
}

.music-toggle:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.25);
}

.music-emoji {
  font-size: 36rpx;
}

/* === 标题区域 === */
.title-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-bottom: 60rpx;
  z-index: 10;
}

.title-main {
  font-size: 80rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 24rpx;
}

.title-sub {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  opacity: 0.8;
}

.separator {
  color: rgba(255, 255, 255, 0.4);
  margin: 0 20rpx;
  font-size: 24rpx;
}

.sub-text {
  font-size: 28rpx;
  letter-spacing: 8rpx;
  color: #eee;
}

.title-quote {
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  font-style: italic;
  font-family: "Songti SC", serif;
}

/* === 菜单按钮区域 === */
.menu-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  z-index: 10;
  width: 100%;
  padding-bottom: 20rpx; /* 增加一点底部缓冲 */
}

.menu-btn {
  width: 80% !important;
  height: 100rpx;
  border-radius: 50rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
  transition: all 0.2s;
  padding: 0 !important;
  line-height: normal !important;
  margin: 0 !important;
}

.menu-btn:active {
  transform: scale(0.96);
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.menu-btn.primary {
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.25),
    rgba(255, 255, 255, 0.1)
  );
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.menu-btn.primary .btn-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 4rpx;
}

.menu-btn.secondary {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.menu-btn.secondary .btn-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

.btn-icon {
  font-size: 36rpx;
}

.about-link {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  opacity: 0.7;
}

.about-link:active {
  opacity: 1;
}

.link-icon {
  font-size: 28rpx;
}
.link-text {
  font-size: 26rpx;
  color: #aaa;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

/* 底部警告 */
.footer-warning {
  margin-top: auto; /* 自动推至底部 */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 10;
}

.warning-text {
  font-size: 20rpx;
  color: rgba(255, 180, 180, 0.6);
  letter-spacing: 2rpx;
}

/* 模态框 */
.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.modal-content {
  width: 560rpx;
  padding: 48rpx;
  background: rgba(30, 40, 50, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: scaleUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.modal-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.modal-btn.cancel {
  background: rgba(255, 255, 255, 0.1);
}

.modal-btn.cancel:active {
  background: rgba(255, 255, 255, 0.15);
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #4a90e2, #0056b3);
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

.modal-btn.confirm:active {
  transform: scale(0.96);
}

.modal-btn-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

.modal-btn-text.highlight {
  color: #fff;
  font-weight: 600;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes scaleUp {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
