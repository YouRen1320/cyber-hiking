<view class="container">
  <!-- 背景图片 -->
  <image class="bg-image" src="{{bgImage}}" mode="aspectFill"></image>
  
  <!-- 渐变遮罩 -->
  <view class="overlay"></view>
  
  <!-- 雪花效果 -->
  <view class="snow-container">
    <view 
      wx:for="{{snowflakes}}" 
      wx:key="id" 
      class="snowflake" 
      style="left:{{item.left}}%; animation-duration:{{item.duration}}s; animation-delay:-{{item.delay}}s; width:{{item.size}}rpx; height:{{item.size}}rpx; opacity:{{item.opacity}}">
    </view>
  </view>
  
  <!-- 音乐开关 -->
  <view class="music-toggle" bindtap="toggleMusic" style="top: {{statusBarHeight + 10}}px; left: 30rpx;">
    <text class="music-emoji">{{isMusicOn ? '🔊' : '🔇'}}</text>
  </view>

  <!-- 内容区域容器 -->
  <view class="content" style="padding-top: {{statusBarHeight + 44}}px;">
    <!-- 标题区域 -->
    <view class="title-area">
      <view class="title-main">徒步鳌太线</view>
      <view class="title-sub">
        <text class="separator">——</text>
        <text class="sub-text">勇 闯 鳌 太</text>
        <text class="separator">——</text>
      </view>
      <view class="title-quote">
        "我们征服不了任何一座山，只是山放过了我们而已。"
      </view>
    </view>

    <!-- 菜单按钮区域 -->
    <view class="menu-area">
      <button class="menu-btn primary start-btn" bindtap="onStartGame">
        <view class="btn-content">
          <text class="btn-icon">🧗</text>
          <text class="btn-text">开始徒步</text>
        </view>
      </button>

      <button class="menu-btn secondary continue-btn" bindtap="onContinueGame" wx:if="{{hasSave}}">
        <view class="btn-content">
          <text class="btn-icon">🏕️</text>
          <text class="btn-text">继续徒步</text>
        </view>
      </button>
      
      <button class="menu-btn secondary gallery-btn" bindtap="onOpenGallery">
        <view class="btn-content">
          <text class="btn-icon">🌌</text>
          <text class="btn-text">结局图鉴</text>
        </view>
      </button>
      
      <view class="agreements-area">
        <text class="agreement-text">查看</text>
        <text class="agreement-link" bindtap="onShowServiceAgreement">《用户服务协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" bindtap="onShowPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>
    
    <!-- 警告文字 -->
    <view class="footer-warning">
      <text class="warning-text">⚠鳌太线是中国十大死亡路线之一，请敬畏自然</text>
    </view>
  </view>
  
  <!-- 信息弹窗 -->
  <view wx:if="{{showInfoModal}}" class="modal-overlay">
    <view class="modal-content">
      <text class="modal-title">{{modalTitle}}</text>
      <scroll-view scroll-y style="max-height: 50vh; width: 100%; margin-bottom: 30rpx;">
        <text class="modal-text" style="white-space: pre-wrap; display: block; text-align: left;">{{modalContent}}</text>
      </scroll-view>
      <view class="modal-actions">
        <view class="modal-btn confirm" bindtap="onCloseInfoModal">
          <text class="modal-btn-text highlight">了解</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 重新开始确认弹窗 -->
  <view wx:if="{{showRestartModal}}" class="modal-overlay">
    <view class="modal-content">
      <text class="modal-title">重新开始</text>
      <text class="modal-text">开始新游戏将覆盖现有存档，确定要重新开始吗？</text>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="onCancelRestart">
          <text class="modal-btn-text">取消</text>
        </view>
        <view class="modal-btn confirm" bindtap="onConfirmRestart">
          <text class="modal-btn-text highlight">确定</text>
        </view>
      </view>
    </view>
  </view>
</view>
