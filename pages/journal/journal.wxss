/* pages/journal/journal.wxss */

.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e, #0f0f1a);
  padding: 100rpx 30rpx 120rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
}

.history-list {
  height: calc(100vh - 280rpx);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: rgba(255, 255, 255, 0.4);
  font-size: 28rpx;
}

.history-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.role-name {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.date {
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
}

.card-body {
  display: flex;
  justify-content: space-between;
}

.ending {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
}

.days {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
}

.back-btn {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn text {
  color: #fff;
  font-size: 28rpx;
}
