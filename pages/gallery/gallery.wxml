<!--pages/gallery/gallery.wxml-->
<view class="container">
  <view class="header">
    <text class="title">结局图鉴</text>
    <text class="subtitle">已解锁 {{unlockedCount}} / {{totalCount}}</text>
  </view>
  
  <scroll-view scroll-y class="endings-list">
    <view 
      wx:for="{{endings}}" 
      wx:key="id" 
      class="ending-card {{item.unlocked ? '' : 'locked'}}">
      <view class="ending-icon">
        <text>{{item.unlocked ? item.icon : '🔒'}}</text>
      </view>
      <view class="ending-info">
        <text class="ending-name">{{item.unlocked ? item.name : '???'}}</text>
        <text class="ending-desc">{{item.unlocked ? item.desc : '尚未解锁'}}</text>
      </view>
    </view>
  </scroll-view>
  
  <view class="back-btn" bindtap="onBack">
    <text>返回</text>
  </view>
</view>
