<view class="container">
  
  <view class="nav-header">
    <view class="back-btn" bindtap="onBack">
      <view class="back-icon"></view>
    </view>
    <view class="tabs">
      <view class="tab {{currentTab === 'items' ? 'active' : ''}}" bindtap="switchTab" data-tab="items">荒野拾遗</view>
      <view class="tab {{currentTab === 'endings' ? 'active' : ''}}" bindtap="switchTab" data-tab="endings">结局图鉴</view>
    </view>
  </view>

  <!-- Items Grid -->
  <scroll-view scroll-y class="gallery-content" wx:if="{{currentTab === 'items'}}">
    <view class="header">
      <text class="subtitle">散落在鳌太线上的记忆碎片 {{unlockedCount}}/10</text>
    </view>

    <view class="grid">
      <block wx:for="{{eggs}}" wx:key="id">
        <view class="item-card {{item.unlocked ? 'unlocked' : 'locked'}}" 
              bindtap="onItemTap" 
              data-id="{{item.id}}">
          <view class="item-icon">{{item.unlocked ? item.icon : '?'}}</view>
          <view class="item-name">{{item.unlocked ? item.name : '未知物品'}}</view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- Endings Grid -->
  <scroll-view scroll-y class="gallery-content" wx:if="{{currentTab === 'endings'}}">
    <view class="header">
      <text class="subtitle">这一路走来的不同结局 {{unlockedEndingsCount}}/10</text>
    </view>

    <view class="grid">
      <block wx:for="{{endings}}" wx:key="id">
        <view class="ending-card {{item.unlocked ? 'unlocked' : 'locked'}}" 
              bindtap="onEndingTap"
              data-id="{{item.id}}">
           <view class="ending-content">
             <view class="ending-name">{{item.unlocked ? item.name : '???'}}</view>
             <view class="ending-desc">{{item.unlocked ? item.desc : '未达成此结局'}}</view>
           </view>
           <view class="status-badge" wx:if="{{item.unlocked}}">已达成</view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- Item Detail Modal -->
  <view class="modal-mask {{showModal ? 'show' : ''}}" bindtap="closeModal">
    <view class="modal-content" catchtap="stopProp">
      <view class="modal-header">
        <view class="modal-icon">{{selectedEgg.icon}}</view>
        <view class="modal-title">{{selectedEgg.name}}</view>
      </view>
      <view class="modal-body">
        <text>{{selectedEgg.story}}</text>
      </view>
      <view class="modal-footer">
        <view class="close-btn" bindtap="closeModal">关闭</view>
      </view>
    </view>
  </view>
</view>