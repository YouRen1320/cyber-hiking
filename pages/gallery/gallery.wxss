/* 全屏布局 */
page {
  height: 100vh;
  background: #0a0a0a;
}

.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

/* === 背景层 === */
.visual-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-image {
  width: 100%;
  height: 100%;
  opacity: 0.4;
  filter: blur(8px) saturate(0.8);
  /* 模糊处理，突出前景 */
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(10, 10, 15, 0.85),
    rgba(10, 10, 15, 0.95)
  );
}

/* === 头部区 === */
.header {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  padding: 100rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 8rpx;
  margin-bottom: 24rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
  background: linear-gradient(45deg, #fff, #a0a0a0);
  -webkit-background-clip: text;
  color: transparent;
  /* 渐变文字 */
}

.subtitle-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10px);
}

.count-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-right: 12rpx;
}

.count-value {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
  font-family: monospace;
}

/* === 卡片列表区 === */
.endings-list {
  position: relative;
  z-index: 10;
  flex: 1;
  height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.ending-card {
  position: relative;
  display: flex;
  background: rgba(30, 30, 35, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  backdrop-filter: blur(12px);
  transition: transform 0.2s, background 0.2s;
}

.ending-card:active {
  transform: scale(0.98);
}

.ending-card.locked {
  background: rgba(20, 20, 25, 0.4);
  border-color: rgba(255, 255, 255, 0.03);
}

.ending-card.unlocked {
  background: linear-gradient(
    135deg,
    rgba(40, 45, 60, 0.7),
    rgba(30, 35, 45, 0.7)
  );
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

/* 左侧图标 */
.card-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  flex-shrink: 0;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.unlocked .card-icon-wrapper {
  background: radial-gradient(
    circle at center,
    rgba(52, 152, 219, 0.2),
    rgba(0, 0, 0, 0.3)
  );
  border-color: rgba(52, 152, 219, 0.3);
}

.card-icon {
  font-size: 48rpx;
}

/* 内容区 */
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #e0e0e0;
  letter-spacing: 1px;
}

.locked .card-name {
  color: #666;
  font-family: monospace;
}

.unlock-tag {
  font-size: 20rpx;
  background: rgba(46, 204, 113, 0.2);
  color: #2ecc71;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(46, 204, 113, 0.3);
  font-weight: 600;
}

.card-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.locked .card-desc {
  color: rgba(255, 255, 255, 0.2);
  font-style: italic;
}

/* 装饰元素 */
.card-deco {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-top: 60rpx solid rgba(255, 255, 255, 0.03);
  border-left: 60rpx solid transparent;
}

.unlocked .card-deco {
  border-top-color: rgba(52, 152, 219, 0.2);
}

/* === 底部按钮区 === */
.footer-action {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  padding: 20rpx 0 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  background: linear-gradient(0deg, rgba(10, 10, 15, 0.95), transparent);
  /* 底部渐变遮盖 */
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 280rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 44rpx;
  transition: all 0.2s;
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.96);
}

.back-btn text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.back-icon {
  font-size: 32rpx;
  margin-top: -4rpx;
}
