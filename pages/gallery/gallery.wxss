/* pages/gallery/gallery.wxss */

.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e, #0f0f1a);
  padding: 100rpx 30rpx 120rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.endings-list {
  height: calc(100vh - 300rpx);
}

.ending-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  transition: all 0.2s;
}

.ending-card.locked {
  opacity: 0.5;
}

.ending-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.ending-icon text {
  font-size: 40rpx;
}

.ending-info {
  flex: 1;
}

.ending-name {
  display: block;
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ending-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.back-btn {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn text {
  color: #fff;
  font-size: 28rpx;
}
