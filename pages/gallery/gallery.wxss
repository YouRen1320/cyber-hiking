/* pages/gallery/gallery.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #000;
  padding: 0;
  box-sizing: border-box;
  color: #fff;
  background-size: cover;
  background-position: center;
}

.header {
  margin-bottom: 60rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #666;
  letter-spacing: 8rpx;
  margin-bottom: 20rpx;
}

.desc {
  font-size: 24rpx;
  color: #888;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 3列 */
  gap: 30rpx;
}

.grid-item {
  background: #111;
  border-radius: 12rpx;
  padding: 30rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px solid #222;
  transition: all 0.2s;
}

/* Navigation Header */
.nav-header {
  position: relative;
  width: 100%;
  height: 88px; /* Includes status bar area */
  padding-top: 44px; /* Space for status bar */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  z-index: 10;
  flex-shrink: 0;
}

.back-btn {
  position: absolute;
  left: 20rpx;
  bottom: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid rgba(255, 255, 255, 0.9);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.9);
  transform: rotate(45deg);
}

/* Tabs */
.tabs {
  display: flex;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 32rpx;
  padding: 4rpx;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.tab {
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  border-radius: 28rpx;
  transition: all 0.3s ease;
}

.tab.active {
  background: rgba(255, 255, 255, 0.9);
  color: #000;
  font-weight: bold;
}

/* Content Area */
.gallery-content {
  flex: 1;
  height: 0; /* Crucial for scroll-view in flex */
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

.header {
  padding: 20rpx 40rpx;
  text-align: center;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

/* Grid Layout */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 20rpx 30rpx;
}

/* Item Card */
.item-card {
  aspect-ratio: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.item-card.unlocked {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.3);
}

.item-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  opacity: 0.5;
}

.item-card.unlocked .item-icon {
  opacity: 1;
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

.item-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.item-card.unlocked .item-name {
  color: rgba(255, 255, 255, 0.9);
}

/* Ending Card */
.ending-card {
  grid-column: span 3; /* Full width */
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx; /* Actually handled by grid gap, but good for safety */
  position: relative;
  overflow: hidden;
}

.ending-card.locked {
  opacity: 0.6;
}

.ending-content {
  flex: 1;
}

.ending-name {
  font-size: 32rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.ending-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
}

.status-badge {
  font-size: 20rpx;
  color: #000;
  background: rgba(255, 255, 255, 0.9);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
  margin-left: 20rpx;
}

/* Modal Styles */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(10px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
}

.modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 600rpx;
  background: rgba(20, 20, 20, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 0;
  overflow: hidden;
  transform: scale(0.9);
  transition: all 0.3s cubic-bezier(0.19, 1, 0.22, 1);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.modal-mask.show .modal-content {
  transform: scale(1);
}

.modal-header {
  padding: 40rpx 0;
  text-align: center;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.05) 0%,
    rgba(255, 255, 255, 0) 100%
  );
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.modal-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 2rpx;
}

.modal-body {
  padding: 40rpx;
  min-height: 200rpx;
  max-height: 50vh;
  overflow-y: auto;
  font-size: 28rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.8);
  white-space: pre-wrap;
  text-align: justify;
}

.modal-footer {
  padding: 30rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: center;
}

.close-btn {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 100rpx;
  transition: all 0.2s ease;
}

.close-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}
